PORT=3000
CORS_ORIGIN=http://localhost:5173

# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

DB_HOST=localhost
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=password123
DB_NAME=inventario_telas

# URLs usadas en los enlaces de los correos.
# Para abrirlos desde el celular (misma Wi-Fi) usa la IP local del PC en vez de localhost,
# p. ej. http://192.168.1.10:3000 (consúltala con `ipconfig`, adaptador Wi-Fi -> Dirección IPv4).
API_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# --- Correo SMTP (Gmail) ---
# SMTP_PASS es una "Contraseña de aplicación" de 16 caracteres, NO la contraseña normal de Gmail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Recibe los enlaces de aprobación de cuentas nuevas
SUPER_ADMIN_EMAIL=
# Recibe las alertas de stock crítico (si se deja vacío se usa SUPER_ADMIN_EMAIL)
ALERTAS_STOCK_EMAIL=
