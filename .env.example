# Variables de docker-compose.yml (despliegue en el servidor).
# Copia este archivo como .env en la raíz del proyecto y completa los valores.
# NUNCA subas el .env a git.

# URL pública de la app, sin "/" al final: http://<IP-del-servidor> (o el dominio).
# Se usa en los enlaces de los correos.
PUBLIC_URL=http://203.0.113.10

# Puerto donde se publica la app (80 = http normal).
HTTP_PORT=80

# Base de datos (solo la usan los contenedores; no se expone a internet).
DB_USER=admin
DB_PASSWORD=
DB_NAME=inventario_telas

# Genera uno con: openssl rand -hex 48
JWT_SECRET=
JWT_EXPIRES_IN=8h

# --- Correo SMTP (Gmail) ---
# SMTP_PASS es una "Contraseña de aplicación" de 16 caracteres, NO la contraseña normal de Gmail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Recibe los enlaces de aprobación de cuentas nuevas
SUPER_ADMIN_EMAIL=
# Recibe las alertas de stock crítico (si se deja vacío se usa SUPER_ADMIN_EMAIL)
ALERTAS_STOCK_EMAIL=
